# Скопируйте в .env рядом с docker-compose.yml и заполните.
# Файл .env содержит пароли и в репозиторий не попадает.

# Домен, на который смотрит сервер. На него же выпишется сертификат.
DOMAIN=cornet.example.ru

# База. Пароль придумайте длинный — наружу порт не открыт, но пусть будет.
POSTGRES_USER=cornet
POSTGRES_PASSWORD=
POSTGRES_DB=cornet

# Ключ шифрования секретов двухфакторной аутентификации.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ВАЖНО: перенесите ЗНАЧЕНИЕ СО СТАРОГО СЕРВЕРА, если 2FA уже кем-то включена —
# с новым ключом существующие секреты станет невозможно расшифровать.
TOTP_ENC_KEY=

# Ключ подписи билетов на скачивание файлов в приложении.
# Сгенерировать той же командой. Если не задать — билеты будут протухать при
# каждом перезапуске, и приложению придётся брать их заново.
MEDIA_TICKET_KEY=

# Уведомления в браузере и в PWA. Пару сгенерировать один раз:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
# Перенесите значения со старого сервера, иначе у всех отвалятся подписки.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Почта: письма подтверждения, восстановление пароля, жалобы и аварийные алерты.
RESEND_API_KEY=
MAIL_FROM=
ALERT_EMAIL=

# Через сколько секунд исчезают сообщения в НОВЫХ чатах. 0 — не исчезают.
# 86400 — сутки, 604800 — неделя, 2592000 — 30 дней.
DEFAULT_AUTO_DELETE_SECONDS=2592000

# TURN-сервер для звонков через строгий NAT. Без него звонки работают не везде.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
